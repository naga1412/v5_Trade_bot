# =====================================
# trading-radar — Environment Variables
# =====================================
# Copy this file to .env and fill in values.
# Never commit .env to git.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=trading_radar
DATABASE_URL=postgresql://postgres:changeme_strong_password_here@postgres:5432/trading_radar

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Binance (TESTNET FIRST — never use live keys initially) ---
BINANCE_API_KEY=your_testnet_key_here
BINANCE_API_SECRET=your_testnet_secret_here
BINANCE_USE_TESTNET=true

# --- Bybit (Optional backup) ---
BYBIT_API_KEY=your_key_here
BYBIT_API_SECRET=your_secret_here

# --- News API Free Tiers ---
CRYPTOPANIC_TOKEN=your_free_token_from_cryptopanic.com
TWELVEDATA_API_KEY=your_free_key_from_twelvedata.com
GLASSNODE_API_KEY=your_free_key_from_glassnode.com

# --- Telegram (For alerts) ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_BotFather
TELEGRAM_CHAT_ID=your_chat_id

# --- App Configuration ---
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=generate_with_python_secrets_token_urlsafe_64
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Freqtrade ---
FREQTRADE_DRY_RUN=true
FREQTRADE_INITIAL_CAPITAL=10000

# --- Grafana ---
GRAFANA_PASSWORD=changeme_admin_password

# --- AI Training (Optional — Google Colab default) ---
USE_LOCAL_GPU=false
HUGGINGFACE_TOKEN=optional_for_finbert_download
