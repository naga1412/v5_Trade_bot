.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.log
.hypothesis/

# Virtual envs
.venv/
venv/
env/
ENV/
.python-version

# --- Node / Frontend ---
node_modules/
.pnpm-store/
dist/
build/
.next/
.nuxt/
out/
.cache/
.parcel-cache/
.turbo/
.vite/
