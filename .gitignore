*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- ML / Data ---
*.pt
*.pth
*.onnx
*.pkl
*.joblib
*.h5
*.hdf5
checkpoints/
mlruns/
mlflow.db
.dvc/cache/
.dvc/tmp/
*.dvc.local

# Data files (large, versioned via DVC instead of git)
data/raw/
data/processed/
data/external/
data/interim/

# --- Databases ---
*.sqlite
*.sqlite3
*.db
postgres_data/
redis_data/
*.dump
backup/

# --- Docker ---
docker-compose.override.yml
*.local.yml

# --- IDE ---
.vscode/
!.vscode/settings.json.example
!.vscode/launch.json.example
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Logs ---
logs/
*.log
log/

# --- Temp ---
tmp/
temp/
*.tmp

# --- Worktrees ---
worktrees/

# --- Memory (private to each Claude instance) ---
memory/
.claude/local/

