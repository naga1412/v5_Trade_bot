# =====================================
# trading-radar — .gitignore
# =====================================

# --- Secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
!backend/app/secrets/
!tools/secrets/
credentials/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.log
.hypothesis/

# Virtual envs
.venv/
venv/
env/
ENV/
.python-version

# --- Node / Frontend ---
node_modules/
.pnpm-store/
dist/
build/
.next/
.nuxt/
out/
.cache/
.parcel-cache/
.turbo/
.vite/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- ML / Data ---
*.pt
*.pth
*.onnx
*.pkl
*.joblib
*.h5
*.hdf5
checkpoints/
mlruns/
mlflow.db
.dvc/cache/
.dvc/tmp/
*.dvc.local

# Data files (large, versioned via DVC instead of git)
data/raw/
data/processed/
data/external/
data/interim/

# --- Databases ---
*.sqlite
*.sqlite3
*.db
postgres_data/
redis_data/
*.dump
backup/
!infra/backup/
# SP-7 Phase A5: tools/backup/ is source code (snapshot/upload_b2/etc CLI
# wrappers), not a data-backup directory. Whitelist it back in.
!backend/tools/backup/

# --- Docker ---
docker-compose.override.yml
*.local.yml

# --- IDE ---
.vscode/
!.vscode/settings.json.example
!.vscode/launch.json.example
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Logs ---
logs/
*.log
log/

# --- Temp ---
tmp/
temp/
*.tmp

# --- Worktrees ---
worktrees/

# --- Memory (private to each Claude instance) ---
memory/
.claude/local/

# --- Test artifacts ---
playwright-report/
playwright/.cache/
test-results/

# --- Profiling ---
*.prof
.profile/

# --- Operational scripts with baked-in secrets ---
# Generated locally for one-off Hetzner deploys; contain TUNNEL_TOKEN,
# TELEGRAM_BOT_TOKEN, CF_ACCESS_AUD. NEVER commit these to GitHub.
hetzner_deploy*.sh
hetzner_fix_*.sh

# --- Transient ---
files.zip
.claude/
tools/oci/poll_ampere.pid
tools/oci/poll_ampere.*.log

# --- ML training artifacts ---
# Local training runs / parquet downloads. Checkpoints are uploaded to
# the production server filesystem, not git.
data/ml/

# --- One-off ops scripts ---
# Throwaway helpers written at repo root for diagnosing or patching
# production. Reference instance-specific data; don't commit.
/activate_*.py
/probe_*.py
