# ===== trading-radar — DEV environment (local docker-compose) =====
#
# Copy this to .env.dev (gitignored) and run:
#   docker compose --env-file .env.dev up -d --build
#
# The dev stack runs the SAME images as prod but with ENV=development
# which makes the backend skip the Cloudflare Access check (so you
# can hit http://localhost:5173 directly without a JWT) and gates
# the autonomous-trading subsystem OFF (so paper-trade-only mode
# stays safe even with a real Binance key in the vault).
#
# Postgres + Redis run in containers with their own volumes
# (postgres_data_dev / redis_data_dev) — completely isolated from
# the prod box's volumes. Drop the volumes any time to start clean:
#   docker compose --env-file .env.dev down -v
#
# Open the dashboard at: http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpass
POSTGRES_DB=trading_radar_dev
DATABASE_URL=postgresql+asyncpg://postgres:devpass@postgres:5432/trading_radar_dev

REDIS_URL=redis://redis:6379/0

ENV=development
LOG_LEVEL=DEBUG
SECRET_KEY=dev-secret-key-do-not-use-in-prod-1234567890abcdef

# CF Access bypassed in development — these values are ignored.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Strong-enough passphrase for dev. Override per-developer if you
# want to test the vault flow with a real secrets.enc.
MASTER_PASSPHRASE=devpass-only-for-local-development-1234

# Always use Binance TESTNET in dev. Real-money trading is gated
# on AUTONOMOUS_TRADING_ENABLED which we leave OFF below.
BINANCE_USE_TESTNET=true
AUTONOMOUS_TRADING_ENABLED=false

# Disable backups in dev (no offsite, no laptop rsync).
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
LAPTOP_RSYNC_TARGET=

# Telegram polling skipped when token is empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GRAFANA_ADMIN_PASSWORD=devpass
