# ===== trading-radar — STAGING environment (Hetzner side-by-side) =====
#
# Copy this to /opt/trading-radar/.env.staging on the Hetzner box.
# The deploy-staging workflow uses it via:
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up
#
# Staging hard rules:
#   - ENV=staging (not production) so CF Access requires a different
#     hostname binding and the backend logs are clearly distinguishable
#   - BINANCE_USE_TESTNET=true ALWAYS (no real-money keys ever)
#   - AUTONOMOUS_TRADING_ENABLED=false (paper-only; even with real
#     keys staging cannot place orders)
#   - Separate Postgres database (trading_radar_staging) and Redis
#     instance (different container)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging_change_me_too
POSTGRES_DB=trading_radar_staging
DATABASE_URL=postgresql+asyncpg://postgres:staging_change_me_too@postgres-staging:5432/trading_radar_staging

REDIS_URL=redis://redis-staging:6379/0

ENV=staging
LOG_LEVEL=DEBUG

# CF Access for staging — set up a separate Cloudflare Access app
# pointing at staging.aji12.nagayuaj.com with whatever auth policy you
# want (e.g. just your email). Paste the audience tag here.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=staging_application_audience_tag

MASTER_PASSPHRASE=staging-only-passphrase-1234567890abc

# Hard-coded in compose, but mirror here for clarity.
BINANCE_USE_TESTNET=true
AUTONOMOUS_TRADING_ENABLED=false
WORKER_ENABLED=true

# No backups for staging — data is disposable.
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
LAPTOP_RSYNC_TARGET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# No grafana for staging.
GRAFANA_ADMIN_PASSWORD=
